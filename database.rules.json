{
  "rules": {
    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid"
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('meta').exists()",
            ".validate": "newData.hasChildren(['displayName','joinedAt'])"
          }
        },
        "records": {
          "$date": {
            "$hour": {
              ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && newData.child('authorUid').val() === auth.uid",
                ".validate": "newData.hasChildren(['date','hour','authorUid','updatedAt'])"
              }
            }
          }
        },
        "notificationSettings": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tokenKey": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "reminderDeliveries": {
      ".read": false,
      ".write": false
    }
  }
}
